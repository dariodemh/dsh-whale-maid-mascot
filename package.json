{
  "name": "dsh-whale-maid-mascot",
  "version": "2.0.1",
  "description": "Whale-chan (DeepSeek 娘) in-page mascot for the DeepSeek Harness web UI: four outfits, mood poses, affection, AI chat and a workspace panel.",
  "author": {
    "name": "dariodemh",
    "url": "https://github.com/dariodemh"
  },
  "contributors": [
