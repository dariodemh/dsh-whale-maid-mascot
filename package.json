    },
    {
      "name": "Amakurai",
      "url": "https://github.com/Amakurai"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dariodemh/dsh-whale-maid-mascot.git"
  },
  "homepage": "https://github.com/dariodemh/dsh-whale-maid-mascot",
  "bugs": {
    "url": "https://github.com/dariodemh/dsh-whale-maid-mascot/issues"
  },
  "type": "module",
